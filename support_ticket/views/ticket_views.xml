<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_it_ticket_list" model="ir.ui.view">
        <field name="name">it.ticket.list</field>
        <field name="model">it.ticket</field>
        <field name="arch" type="xml">
            <list string="Support Tickets">
                <field name="name" decoration-bf="1"/>
                <field name="issue_title"/>
                <field name="reported_by_id"/>
                <field name="assigned_to_id"/>
                <field name="priority" widget="priority" readonly="1"/>
                <field name="state" widget="badge" decoration-info="state == 'new'" decoration-warning="state == 'in_progress'" decoration-success="state == 'resolved'"/>
            </list>
        </field>
    </record>

    <record id="view_it_ticket_kanban" model="ir.ui.view">
        <field name="name">it.ticket.kanban</field>
        <field name="model">it.ticket</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column" records_draggable="0" groups_draggable="0">
                <field name="name"/>
                <field name="issue_title"/>
                <field name="priority"/>
                <field name="state"/>
                <field name="assigned_to_id"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between mb-2">
                            <strong class="fs-5">
                                <field name="name"/>
                            </strong>
                            <field name="priority" widget="priority" readonly="1"/>
                        </div>
                        <div class="text-muted mb-3">
                            <field name="issue_title"/>
                        </div>
                        <footer class="mt-auto d-flex justify-content-end">
                            <field name="assigned_to_id" widget="many2one_avatar_user" readonly="1"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_it_ticket_form" model="ir.ui.view">
        <field name="name">it.ticket.form</field>
        <field name="model">it.ticket</field>
        <field name="arch" type="xml">
            <form string="Support Ticket">
                <header>
                    <button name="action_in_progress" string="Start Work" type="object" class="oe_highlight" invisible="state != 'new'" groups="it_ticket.group_it_ticket_manager"/>
                    <button name="action_resolved" string="Mark Resolved" type="object" class="oe_highlight" invisible="state != 'in_progress'" groups="it_ticket.group_it_ticket_manager"/>
                    <button name="action_closed" string="Close Ticket" type="object" invisible="state != 'resolved'" groups="it_ticket.group_it_ticket_manager"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <h2>
                            <field name="issue_title" placeholder="E.g. Mouse is not working..." readonly="state != 'new'"/>
                        </h2>
                    </div>
                    <group>
                        <group>
                            <field name="reported_by_id"/>
                            <field name="assigned_to_id" readonly="1" force_save="1"/>
                        </group>
                        <group>
                            <field name="priority" widget="priority" readonly="state != 'new'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Please describe the issue in detail..." readonly="state != 'new'"/>
                        </page>
                    </notebook>
                </sheet>

                <chatter/>

            </form>
        </field>
    </record>

    <record id="action_it_ticket" model="ir.actions.act_window">
        <field name="name">Support Tickets</field>
        <field name="res_model">it.ticket</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <menuitem id="menu_it_ticket_root" name="Support HelpDesk" sequence="10" web_icon="it_ticket,static/description/icon.png"/>
    <menuitem id="menu_it_ticket_tickets" name="All Tickets" parent="menu_it_ticket_root" action="action_it_ticket" sequence="10"/>

</odoo>