<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_it_ticket" model="ir.module.category">
            <field name="name">Support HelpDesk</field>
            <field name="sequence">15</field>
        </record>

        <record id="privilege_it_ticket" model="res.groups.privilege">
            <field name="name">Role</field>
            <field name="category_id" ref="module_category_it_ticket"/>
        </record>

        <record id="group_it_ticket_user" model="res.groups">
            <field name="name">User (Own Tickets Only)</field>
            <field name="privilege_id" ref="privilege_it_ticket"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_it_ticket_manager" model="res.groups">
            <field name="name">Manager (All Tickets)</field>
            <field name="privilege_id" ref="privilege_it_ticket"/>
            <field name="implied_ids" eval="[(4, ref('it_ticket.group_it_ticket_user'))]"/>
        </record>

        <record id="base.user_admin" model="res.users">
            <field name="group_ids" eval="[(4, ref('it_ticket.group_it_ticket_manager'))]"/>
        </record>
        <record id="base.user_root" model="res.users">
            <field name="group_ids" eval="[(4, ref('it_ticket.group_it_ticket_manager'))]"/>
        </record>

        <record id="rule_it_ticket_user" model="ir.rule">
            <field name="name">User can only see their own tickets</field>
            <field name="model_id" ref="model_it_ticket"/>
            <field name="groups" eval="[(4, ref('it_ticket.group_it_ticket_user'))]"/>
            <field name="domain_force">[('reported_by_id', '=', user.id)]</field>
        </record>
        <record id="rule_it_ticket_manager" model="ir.rule">
            <field name="name">Manager can see all tickets</field>
            <field name="model_id" ref="model_it_ticket"/>
            <field name="groups" eval="[(4, ref('it_ticket.group_it_ticket_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

    </data>
</odoo>